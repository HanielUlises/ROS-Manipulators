<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arduinobot">
    <gazebo>
        <xacro:if value="$(arg is_ignition)">
            <puglin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
                <parameters>

                </parameters>
            </puglin>
        </xacro:if>
        <xacro:unless value="$(arg is_ignition)">
            <puglin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            </puglin>
        </xacro:unless>
    </gazebo>
</robot>